# WLO staging -- the script defaults to these, the environment wins.
EDU_SHARING_URL=https://repository.staging.openeduhub.net
EDU_SHARING_METADATASET=mds_oeh
# Optional: an account sees more than a guest.
EDU_SHARING_USER=
EDU_SHARING_PASSWORD=
# Only for --backend bapi (embeddings via the WLO LLM proxy, provider openai).
B_API_BASE_URL=
B_API_KEY=
# Web app only.
# Optional: protects the deployed demo -- without it anyone with the link uses your B-API key.
DEMO_PASSWORD=
# Optional: fixed chat model for the LLM rating (default: least loaded one).
LLM_MODEL=
# Optional: embedding model (default text-embedding-3-small).
EMBEDDING_MODEL=
# Optional: portal hosts the server may fetch, comma-separated.
PORTAL_HOSTS=
